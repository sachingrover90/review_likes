 <form{{ attributes }}>
 <section class="container col-md-8 mt-5 merchantregistrationform"><div class="card"><div class="row">
    {{ children }}
    </div></div></section>
  </form>




  <section class="container col-md-8 mt-5 merchantregistrationform">
         <div class="card">
            <div class="row">
               <div class="mb-4">
                  <h4>Section 2: Business Details</h4>
               </div>
               <div class="col-md-6">
                  <label for="blname" class="required mb-2">Legal Business Name</label>
                  <input type="text" id="blname" class="form-control mb-3" placeholder="Legal Business Name" required="">
               </div>
               <div class="col-md-6 brand-section" id="brandSection-1">
                  <div id="brandContainer">
                     <div class="row brand-section" id="brandSection-1">
                        <div class="col-md-8">
                           <label for="Bnames-1" class="required mb-2">Brand Name(s)</label>
                           <input type="text" id="Bnames-1" class="form-control mb-3" placeholder="Brand Name(s)" required="">
                        </div>
                        <div class="col-md-4">
                           <button type="button" class="btn danger mt-4 remove-btn">Remove</button>
                        </div>
                     </div>
                  </div>
                  <div class="row">
                     <button type="button" class="btn addBrandBtn mt-2 ms-2" id="addBrandBtn">+ Add Brand</button>
                     <span class="hint mt-2 mb-3">Add up to 10 brands you operate under.</span>
                  </div>
               </div>
               <div class="col-md-12 mb-3">
                  <label for="stlink" class="required mb-2">Store Link (primary marketplace URL)</label>
                  <input type="text" id="stlink" class="form-control me-4" placeholder="Store Link" required="">
               </div>
               <div class="col-md-12">
                  <div id="platformContainer" class="mb-3">
                     
                  <div class="platform-section" id="platformSection-1">
      <label for="platform-1" class="required mb-2">Online Selling Platforms (links)</label>
      <div class="d-flex storelink-section">
        <input type="text" id="platform-1" class="form-control me-4" placeholder="Platform Link" required="">
        <button type="button" class="btn danger remove-btn">Remove</button>
      </div>
    </div></div>
                  <div class="row ms-1 mt-2">
                     <button type="button" class="btn addPlatformBtn mt-2" id="addPlatformBtn">+ Add Platform Link</button>
                     <span class="hint mt-2 mb-3">Add up to 10 Platform Links you operate under.</span>
                  </div>
               </div>
               <div class="col-md-12">
                  <div id="socialContainer" class="mb-3">
                     
                  <div class="social-section item" id="socialSection-1">
      <div class="row">
        <div class="col-md-4">
          <label class="mb-2">Platform Name</label>
          <input type="text" id="socialPlatform-1" name="socialPlatform[]" class="form-control mb-2" placeholder="Facebook, Instagram, YouTube..." required="">
        </div>
        <div class="col-md-6">
          <label class="mb-2">Page/Profile Link</label>
          <input type="url" id="socialLink-1" name="socialLink[]" class="form-control mb-2" placeholder="https://facebook.com/yourpage" required="">
        </div>
        <div class="col-md-2">
          <button type="button" class="btn danger remove-btn mt-4">Remove</button>
        </div>
      </div>
    </div></div>
                  <div class="row">
                     <button type="button" class="btn addSocialBtn mt-2 ms-2" id="addSocialBtn">+ Add Social</button>
                     <span class="hint mt-2 mb-5">Add your Facebook Page, Instagram Profile, YouTube Channel, Pinterest, etc.</span>
                  </div>
               </div>
               <div class="col-md-6">
                  <label for="w-link" class="required mb-2">Own Website Link</label>
                  <input type="text" id="w-link" class="form-control mb-3" placeholder="https://yourbrand.com" required="">
               </div>
               <div class="col-md-6">
                  <label for="whatsapplink" class="required mb-2">WhatsApp Business Link</label>
                  <input type="text" id="whatsapplink" class="form-control mb-3" placeholder="https://wa.me/" required="">
               </div>
            </div>
         </div>
         <div class="col-md-12 text-end mb-5">
            <button type="button" class="btn danger remove-btn mt-3 me-3" fdprocessedid="kuy8yc">Remove</button>
            <button type="button" class="btn addPlatformBtn mt-3" id="addPlatformBtn" fdprocessedid="0wgm09">Submit Registration</button>
         </div>
      </section>