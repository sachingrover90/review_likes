{#
/**
 * @file
 * Default theme implementation of a views exposed form.
 *
 * Available variables:
 * - form: A render element representing the form.
 *
 * @see template_preprocess_views_exposed_form()
 *
 * @ingroup themeable
 */
#}
{% if q is not empty %}
  {#
    This ensures that, if clean URLs are off, the 'q' is added first,
    as a hidden form element, so that it shows up first in the POST URL.
  #}
{{ q }}
{% endif %}
{#{ form }#}
 {{form.action}}
 {{form.form_build_id}}
 {{form.form_id}}
 {{form.form_token}}

<div class="col-md-2 filtersection">
                  <div class="filter-categories-section">
 <div class="filter">
                     <h5>filter</h5>
                     <div class="categories">
                        <h6 class="cardyellow-text">CATEGORIES</h6>
                        <div class="checkboxsection">
                           <div class="form-check">
                              <input class="form-check-input" type="checkbox" value="Clothing" id="clothing">
                              <label class="form-check-label" for="clothing">
                             {{form.field_filter_target_id}}
                              </label>
                           </div>
                         
                        </div>
                        <a href="javascript:void(0);" id="toggleLink" style="display: none;" onclick="toggleCategories()">More</a>
                     </div>
                  </div>
               </div>
            </div>
            


                     <form class="form-inline my-2 my-lg-0 d-flex">
                        <input class="form-control" type="search" placeholder="Search Prodcuts Here..." aria-label="Search">
                        <button class="btn btn-default" type="submit">Search</button>
                     </form>