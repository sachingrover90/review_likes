{#
/**
 * @file
 * Default theme implementation for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 *
 * @ingroup themeable
 */
#}


{% set form_id = element['#id'] %}

{% if form_id == 'views-exposed-form-product-block-1' %}
<form{{ attributes.addclass('form-inline', 'my-2', 'my-lg-0', 'd-flex') }}>
  {{ children }}
</form>
{% else %}
<form{{ attributes }}>
  {{ children }}
</form>
{% endif %}


