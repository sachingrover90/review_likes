{#
/**
 * @file
 * Default theme implementation for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 *
 * @ingroup themeable
 */
#}
       <div class="container-fluid">
            <div class="row">
               <div class="col-sm-7 contentsection">
                 <form{{ attributes }}>
        {{ element.form_build_id }}
        {{ element.form_token }}
        {{ element.form_id }}


                     <h2 class="text-center mb-5">Sign Up</h2>
                     <div class="row">
                     	
                        <div class="col-md-6">
                       {% set name = element.account.name['#children'] %}
	{{ name|trim|raw }}
	{% set input_name = element.account.name['#input'] %}
	

                        </div>
                        <div class="col-md-6">
                           {% set lastname = element.field_last_name['#children'] %}
	{{ lastname|trim|raw }}
	<!-- {% set input_last_name = element.field_last_name['#input'] %}
	{{ input_last_name|raw }} -->

                        </div>
                        <div class="col-md-6">
                           {% set mail = element.account.mail['#children'] %}
	{{ mail|trim|raw }}
	<!-- {% set input_mail = element.account.mail['#input'] %}
	{{ input_mail|raw }} -->

                        </div>
                        <div class="col-md-6">
                           {% set number = element.field_phone_number['#children'] %}
	{{ number|trim|raw }}
	<!-- {% set input_number = element.field_phone_number['#input'] %}
	{{ input_number|raw }} -->

                        </div>

                        
                      <!--   <div class="col-md-12">
                          {% set number = element.field_roles['#children'] %}
	{{ number|trim|raw }}
	{% set input_roles = element.field_roles['#input'] %}
	{{ input_roles|raw }}

                        </div> -->
                        <div class="col-md-12">
                           {% set pass = element.account.pass['#children'] %}
	{{ pass|trim|raw }}
	<!-- {% set input_pass1 = element.account.pass['#input'] %}
	{{ input_pass1|raw }} -->

                        </div>
                    
                        <div class="col-md-12 text-center mt-2">
                          {{element.actions}}
                        </div>
                        <div class="termspolicy">I accept the <a href="#">Terms of Use & Privacy Policy</a></div>
                        <div class="signin mt-3">Already have an account? <a href="{{url('<front>')}}/user/login">Login here.</a></div>
                     </div>
                  </form>
               </div>
               <div class="col-sm-5 logosection">
                  <span class="logo">ReviewLikes</span>
                  <div class="image-section text-center">
                     <img src="/review_likes\web\themes\custom\review_likes\images\signup\signup.svg" alt="sign up image" class="w-50">
                  </div>
               </div>
            </div>
            